# ==========================================
# UNIFIED PRODUCTION .GITIGNORE
# Pusdatin Kemenag Barito Utara (FE + BE)
# ==========================================

# --- Environment & Secret Keys ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# --- Frontend (Node, Astro, Vite, Build Output) ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.astro/
frontend/.astro/
.cache/
.turbo/
.eslintcache

# --- PWA & Auto-Generated Service Workers ---
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/fallback-*.js
public/swe-worker-*.js
frontend/public/sw.js
frontend/public/sw.js.map
frontend/public/workbox-*.js
frontend/public/workbox-*.js.map

# --- Backend (Go Air Hot Reload & Binaries) ---
backend/bin/
backend/tmp/
bin/
tmp/
*.exe
*.exe animate
*.exe.stackdump
*.dll
*.so
*.dylib

# --- Database & Storage Uploads ---
*.db
*.sqlite
*.sqlite3
backend/data/*.db
# Ignore actual upload storage directories (NOT the Astro pages/uploads/ route)
/uploads/
backend/uploads/
frontend/public/uploads/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Testing & Coverage ---
coverage/
test-results/
playwright-report/
*.tsbuildinfo

# --- IDE & System Junk ---
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# --- AI Assistant & Temporary Scratch ---
.gemini/
.claude/
.opencode/
.antigravitycli/
scratch/
