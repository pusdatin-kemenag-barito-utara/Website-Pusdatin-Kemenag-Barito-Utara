# ==========================================
# UNIFIED ENTERPRISE PRODUCTION .GITIGNORE
# Pusdatin Kemenag Barito Utara (FE + BE)
# ==========================================

# --- Environment & Secret Keys (Strict Zero Leaks) ---
.env
.env.*
!.env.example
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# --- Infisical CLI Cache & Local Credentials ---
.infisical/
**/.infisical/
secrets/
*.secret
*.token

# --- Certificates, Private Keys & Keystores ---
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
*.keystore
id_rsa
id_rsa*
id_ed25519
id_ed25519*

# --- Frontend (Node, Astro, Vite, Build Output) ---
node_modules/
**/node_modules/
dist/
**/dist/
.astro/
**/.astro/
.cache/
.turbo/
.eslintcache

# --- PWA & Auto-Generated Service Workers ---
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/fallback-*.js
public/swe-worker-*.js
frontend/public/sw.js
frontend/public/sw.js.map
frontend/public/workbox-*.js
frontend/public/workbox-*.js.map

# --- Backend (Go Air Hot Reload & Binaries) ---
backend/bin/
backend/tmp/
bin/
tmp/
*.exe
*.exe animate
*.exe.stackdump
*.dll
*.so
*.dylib

# --- Database Dumps & Storage Uploads ---
*.db
*.sqlite
*.sqlite3
*.sql
*.sql.gz
*.dump
*.bak
backend/data/*.db
# Ignore actual upload storage directories (NOT the Astro pages/uploads/ route)
/uploads/
backend/uploads/
frontend/public/uploads/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Testing & Coverage ---
coverage/
test-results/
playwright-report/
*.tsbuildinfo

# --- IDE & System Junk ---
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# --- AI Assistant & Temporary Scratch ---
.gemini/
**/.gemini/
.claude/
.opencode/
.antigravitycli/
scratch/
**/.agents/scratch/
