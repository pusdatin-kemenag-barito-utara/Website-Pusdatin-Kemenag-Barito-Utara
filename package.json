{
  "name": "pusdatin-kemenag",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo Pusdatin Kemenag Barito Utara — Astro frontend + Go Fiber backend",
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "install:all": "npm install && npm run install:api",
    "install:web": "npm --prefix frontend install",
    "install:frontend": "npm run install:web",
    "install:api": "go -C backend mod download",
    "install:backend": "npm run install:api",
    "dev": "npx -y concurrently -k -p \"[{name}]\" -c \"cyan,magenta\" -n \"backend,frontend\" \"cd backend && air\" \"cd frontend && npm run dev\"",
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "go -C backend run github.com/air-verse/air@v1.61.7 -c .air.toml",
    "dev:api:plain": "go -C backend run ./cmd/server",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm --prefix frontend run build",
    "build:api": "go -C backend build -o bin/api ./cmd/server",
    "start": "concurrently -k -n WEB,API -c cyan,green \"npm run start:web\" \"npm run start:api\"",
    "start:web": "npm --prefix frontend run start",
    "start:api": "./backend/bin/api",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "go -C backend test ./...",
    "gen": "go -C backend run github.com/sqlc-dev/sqlc/cmd/sqlc generate"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
