# ==============================================================================
# Monorepo Environment Configuration Template (.env.example)
# Salin file ini menjadi .env pada server/VPS production
# ==============================================================================

# Database Connection (PostgreSQL Direct / Pooler)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres"

# Supabase Configuration
PUBLIC_SUPABASE_URL=https://db.your-domain.com
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudflare Turnstile Security
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Super Admin Default
SUPER_ADMIN_EMAIL=admin@kemenag.go.id

# Cloudflare R2 Object Storage
CLOUDFLARE_ACCOUNT_ID="your_account_id"
CLOUDFLARE_API_TOKEN="your_api_token"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_ENDPOINT_URL="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"

# R2 Storage Buckets
R2_BUCKET_ARSIP="data-arsip"
R2_BUCKET_INKLUSI="data-inklusi"
R2_BUCKET_PPID="data-ppid"
R2_BUCKET_PTSP="data-ptsp"
R2_BUCKET_SURAT="data-surat"
R2_BUCKET_PUSDATIN="data-pusdatin"

# Security & Encryption Secrets
TRUSTED_DEVICE_SECRET="your_secure_random_hmac_secret_key"

# Server Ports & URLs
PORT=8080
PUBLIC_SITE_URL=https://pusdatin.kemenag-baritoutara.com
BACKEND_URL=http://localhost:8080
REDIS_URL=""
