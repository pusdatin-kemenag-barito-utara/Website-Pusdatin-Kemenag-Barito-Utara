---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LandingShell from "@/components/layout/LandingShell.astro";
import { PengumumanClientContent } from "@/components/landing/PengumumanClientContent";
import { getAnnouncementsData } from "@/lib/landing-data";

const title = "Pengumuman Resmi | PUSDATIN KEMENAG BARITO UTARA";
const description = "Informasi, berita resmi, dan pembaruan rilis sistem dari Pusat Data dan Teknologi Informasi Kementerian Agama Kabupaten Barito Utara.";
const canonical = "/pengumuman";

const announcements = await getAnnouncementsData();
---

<BaseLayout {title} {description} {canonical}>
  <LandingShell>
    <PengumumanClientContent client:load announcements={announcements} />
  </LandingShell>
</BaseLayout>
