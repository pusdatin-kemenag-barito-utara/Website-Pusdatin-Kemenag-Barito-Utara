---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LandingShell from "@/components/layout/LandingShell.astro";
import { LayananClientContent } from "@/components/landing/LayananClientContent";

import { getLandingData } from "@/lib/landing-data";

const title = "Layanan Aplikasi Terintegrasi | PUSDATIN KEMENAG BARITO UTARA";
const description = "Daftar portal dan aplikasi satelit terintegrasi dalam ekosistem Single Sign-On (SSO) Kementerian Agama Kabupaten Barito Utara.";
const canonical = "/layanan";

const landingData = await getLandingData();
const serializedApps = JSON.parse(JSON.stringify(landingData.apps));
---

<BaseLayout {title} {description} {canonical}>
  <LandingShell>
    <LayananClientContent client:load apps={serializedApps} />
  </LandingShell>
</BaseLayout>
