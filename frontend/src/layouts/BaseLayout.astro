---
import "@/styles/global.css";
import { ThemeProvider } from "@/components/layout/ThemeProvider";
import GoogleAnalytics from "@/components/analytics/GoogleAnalytics.astro";
import CloudflareInsights from "@/components/analytics/CloudflareInsights.astro";
import { env } from "@/lib/env";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noIndex?: boolean;
  noTransitions?: boolean;
}

const {
  title = "PUSDATIN KEMENAG BARITO UTARA",
  description = "Portal Resmi Pusat Data dan Teknologi Informasi Kementerian Agama Kabupaten Barito Utara. Layanan autentikasi Single Sign-On (SSO) terpusat, manajemen aplikasi publik, dan portal keagamaan terpadu.",
  canonical = "/",
  noIndex = false,
  noTransitions = false,
} = Astro.props;

const baseUrl = env.siteUrl || "https://pusdatin.kemenag-baritoutara.com";

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "PUSDATIN KEMENAG BARITO UTARA",
  alternateName: [
    "PUSDATIN Kemenag Barito Utara",
    "PUSDATIN KEMENAG BARUT",
    "Pusdatin Kemenag Barito Utara",
  ],
  url: "https://pusdatin.kemenag-baritoutara.com",
};

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "GovernmentOrganization",
  name: "PUSDATIN KEMENAG BARITO UTARA",
  alternateName: "PUSDATIN Kementerian Agama Kabupaten Barito Utara",
  url: "https://pusdatin.kemenag-baritoutara.com",
  logo: "https://pusdatin.kemenag-baritoutara.com/branding/pusdatin.png",
  image: "https://pusdatin.kemenag-baritoutara.com/branding/pusdatin.png",
  description:
    "Pusat Data dan Teknologi Informasi — portal pengelolaan data master dan layanan aplikasi terpadu Kementerian Agama Kabupaten Barito Utara.",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Jl. Ahmad Yani No. 126",
    addressLocality: "Muara Teweh",
    addressRegion: "Kalimantan Tengah",
    addressCountry: "ID",
  },
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+62-851-1749-1212",
    contactType: "customer service",
    email: "baritoutara@kemenag.go.id",
    availableLanguage: ["Indonesian"],
  },
  sameAs: [
    "https://baritoutara.kemenag.go.id",
    "https://youtube.com",
    "https://instagram.com",
    "https://facebook.com",
  ],
};

const sitelinksJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: [
    {
      "@type": "SiteNavigationElement",
      position: 1,
      name: "Layanan Aplikasi",
      url: "https://pusdatin.kemenag-baritoutara.com/layanan",
    },
    {
      "@type": "SiteNavigationElement",
      position: 2,
      name: "Profil Organisasi",
      url: "https://pusdatin.kemenag-baritoutara.com/profil",
    },
    {
      "@type": "SiteNavigationElement",
      position: 3,
      name: "Pengumuman Resmi",
      url: "https://pusdatin.kemenag-baritoutara.com/pengumuman",
    },
    {
      "@type": "SiteNavigationElement",
      position: 4,
      name: "Login Admin",
      url: "https://pusdatin.kemenag-baritoutara.com/login",
    },
  ],
};
---

<!doctype html>
<html lang="id" class="font-sans">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1"
    />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#006838" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#020617" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />
    <meta
      name="googlebot"
      content={noIndex ? "noindex, nofollow" : "index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"}
    />
    <meta name="format-detection" content="email=no, address=no, telephone=no" />
    <meta name="keywords" content="PUSDATIN, PUSDATIN KEMENAG BARITO UTARA, Kemenag Barito Utara, Pusat Data dan Teknologi Informasi Kemenag, Kementerian Agama Barito Utara, Muara Teweh Kemenag, SSO Kemenag Barito Utara, Layanan Digital Kemenag, PTSP Kemenag Barito Utara, Data Keagamaan Barito Utara" />
    <meta name="author" content="PUSDATIN KEMENAG BARITO UTARA" />
    <meta name="creator" content="PUSDATIN KEMENAG BARITO UTARA" />
    <meta name="publisher" content="PUSDATIN KEMENAG BARITO UTARA" />
    <meta name="application-name" content="PUSDATIN KEMENAG BARITO UTARA" />

    <!-- Google Fonts API: Exclusive Plus Jakarta Sans Font Family -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
      rel="stylesheet"
    />

    <!-- Resource Hints: DNS Prefetch & Preconnect for High-Speed Connection Setup -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
    <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />
    <link rel="preconnect" href="https://db.kemenag-baritoutara.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://challenges.cloudflare.com" />
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
    <link rel="dns-prefetch" href="https://db.kemenag-baritoutara.com" />

    <!-- Priority Hints: Preload Critical Above-The-Fold Assets -->
    <link rel="preload" href="/branding/pusdatin.png" as="image" type="image/png" fetchpriority="high" />

    <!-- Cloudflare Turnstile Script -->
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>

    <link rel="canonical" href={`${baseUrl}${canonical}`} />
    <link rel="icon" href="/branding/pusdatin.png" />
    <link rel="apple-touch-icon" href="/branding/pusdatin.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="PUSDATIN KEMENAG BARITO UTARA" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Open Graph / Facebook / WhatsApp (Enterprise Full Spec) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:url" content={`${baseUrl}${canonical}`} />
    <meta property="og:site_name" content="PUSDATIN KEMENAG BARITO UTARA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${baseUrl}/branding/pusdatin.png`} />
    <meta property="og:image:secure_url" content={`${baseUrl}/branding/pusdatin.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content="Logo PUSDATIN KEMENAG BARITO UTARA" />

    <!-- Twitter / X Card (Enterprise Full Spec) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@kemenag_ri" />
    <meta name="twitter:creator" content="@kemenag_ri" />
    <meta name="twitter:domain" content={new URL(baseUrl).hostname} />
    <meta name="twitter:url" content={`${baseUrl}${canonical}`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${baseUrl}/branding/pusdatin.png`} />
    <meta name="twitter:image:alt" content="Logo PUSDATIN KEMENAG BARITO UTARA" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(sitelinksJsonLd)} is:inline />

    <!-- Enterprise PWA Service Worker Registration -->
    <script is:inline>
      if ("serviceWorker" in navigator && (window.location.protocol === "https:" || window.location.hostname === "localhost")) {
        window.addEventListener("load", () => {
          navigator.serviceWorker
            .register("/sw.js")
            .then((reg) => {
              // Check for updates periodically
              reg.onupdatefound = () => {
                const installingWorker = reg.installing;
                if (installingWorker) {
                  installingWorker.onstatechange = () => {
                    if (installingWorker.state === "installed" && navigator.serviceWorker.controller) {
                      console.log("[PWA] Update PUSDATIN Service Worker tersedia.");
                    }
                  };
                }
              };
            })
            .catch((err) => {
              console.debug("[PWA] Service Worker registration:", err);
            });
        });
      }
    </script>

    <GoogleAnalytics />
    <CloudflareInsights />
    {!noTransitions && <ClientRouter />}
  </head>
  <body class="font-sans antialiased">
    <ThemeProvider client:load />
    <slot />
  </body>
</html>
